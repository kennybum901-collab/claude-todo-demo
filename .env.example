# ---- Company (appears on every site footer and email) ----
COMPANY_NAME=Northstar Web Studio
COMPANY_EMAIL=hello@yourstudio.com
COMPANY_ADDRESS=123 Main St, Austin, TX 78701
COMPANY_URL=https://yourstudio.com
OWNER_NAME=Alex

# ---- Pricing (cents) ----
SETUP_FEE_CENTS=49900
MONTHLY_FEE_CENTS=4900
CURRENCY=usd

# ---- Safety: keep 1 until you've reviewed sites and emails ----
DRY_RUN=1
DAILY_EMAIL_CAP=30
FOLLOWUP_DAYS=4
MAX_FOLLOWUPS=2

# ---- Lead search: "niche|city" pairs separated by ; ----
GOOGLE_PLACES_API_KEY=
LEAD_QUERIES=plumber|Austin, TX;roofer|Austin, TX;hair salon|Austin, TX

# ---- AI copywriting (optional) ----
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ---- Hosting / payments / email ----
NETLIFY_TOKEN=
STRIPE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=

# ---- Obsidian ----
# Folder the bots write CRM notes + dashboard into (default ./vault)
# OBSIDIAN_VAULT=/Users/you/Documents/MyVault
OBSIDIAN_SYNC=1

# ---- Upsells (add-on offers to existing clients) ----
UPSELL_ENABLED=1
UPSELL_AFTER_DAYS=60
UPSELL_GAP_DAYS=30

# ---- Multiple sending inboxes (copy senders.example.json -> senders.json) ----
# SENDERS_FILE=senders.json
# SENDER1_PASSWORD=app-password-here
# SENDER2_PASSWORD=app-password-here
BOUNCE_PAUSE_RATE=0.05

# ---- Server (python -m agency serve / docker compose) ----
# PUBLIC_URL=https://bots.yourstudio.com
PORT=8000
RUN_EVERY_MINUTES=60
# Stripe dashboard -> Developers -> Webhooks -> add endpoint https://<PUBLIC_URL>/stripe/webhook
#   events: checkout.session.completed, customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
# Random string for signing unsubscribe links: python -c "import secrets;print(secrets.token_hex(32))"
APP_SECRET=

# ---- Monthly client reports ----
REPORTS_ENABLED=1
REPORT_DAY=1

# ---- 24/7 supervisor (python -m agency supervise) ----
# Push alerts to your phone: Slack/Discord webhook URL, or https://ntfy.sh/<your-secret-topic>
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
BACKUP_KEEP_DAYS=14
MIN_FREE_DISK_MB=500

# ---- Win-back (churned clients + silent prospects) ----
WINBACK_ENABLED=1
WINBACK_CHURN_DAYS=30
WINBACK_LOST_DAYS=90

# ---- Performance dashboard at https://<PUBLIC_URL>/admin (user: admin) ----
ADMIN_PASSWORD=

# ---- Lead scoring: leads scoring below this are never cold-emailed (0 = off) ----
MIN_LEAD_SCORE=0

# ---- Daily review email (sent even in DRY_RUN, only to you) ----
DIGEST_ENABLED=1
DIGEST_EMAIL=
DIGEST_HOUR=13
DIGEST_SAMPLE=5

# ---- Referral program (needs PUBLIC_URL) ----
REFERRALS_ENABLED=1
REFERRAL_DISCOUNT_CENTS=10000

# ---- Site design: force one for every new site (classic|bold|elegant|fresh); empty = match the niche ----
SITE_THEME=
