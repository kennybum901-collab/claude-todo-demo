# SiteSprout starter settings (no secrets). Use it as the starting point for setup:
#   cp sitesprout.env .env && python -m agency setup
# The wizard keeps these as defaults and asks for everything else (address, email, keys).
COMPANY_NAME=SiteSprout
COMPANY_URL=https://sitesproutaustin.com
SETUP_FEE_CENTS=49900
MONTHLY_FEE_CENTS=4900
CURRENCY=usd
DRY_RUN=1
DAILY_EMAIL_CAP=20
LEAD_QUERIES="roofer|Austin, TX;plumber|Austin, TX;hair salon|Austin, TX;barber|Austin, TX;landscaper|Austin, TX;lawn care|Austin, TX"
SMS_TIMEZONE=America/Chicago
