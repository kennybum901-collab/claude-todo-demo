{% extends "site/base.html.j2" %}
{#- Salons, spas, barbers: serif headings, cream background, centred and calm. -#}
{% block theme_css %}
  .actions { display: flex; flex-wrap: wrap; gap: 10px; } .actions { justify-content: center; }
  body { margin: 0; font-family: "Helvetica Neue", Arial, sans-serif; color: #2b2522; background: #fbf8f4; line-height: 1.7; }
  h1, h2, h3, .logo { font-family: Georgia, "Times New Roman", serif; font-weight: 400; }
  header { padding: 22px 0; text-align: center; }
  .logo { font-size: 1.6rem; letter-spacing: .04em; }
  nav { margin-top: 6px; font-size: .9rem; letter-spacing: .12em; text-transform: uppercase; }
  nav a { color: #2b2522; text-decoration: none; margin: 0 10px; }
  .hero { text-align: center; padding: 72px 0 80px; border-top: 1px solid #e8dfd5; border-bottom: 1px solid #e8dfd5; }
  .hero h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); line-height: 1.15; margin: 0 auto 14px; max-width: 760px; }
  .hero p { font-size: 1.2rem; color: #6b605a; max-width: 560px; margin: 0 auto 28px; font-style: italic; }
  .btn { border-radius: 999px; padding: 13px 30px; letter-spacing: .06em; }
  .hero .btn + .btn { background: transparent; color: #2b2522; border: 1px solid #2b2522; }
  h2 { text-align: center; font-size: 2rem; margin: 0 0 28px; }
  .menu { max-width: 680px; margin: 0 auto; }
  .item { display: flex; justify-content: space-between; gap: 16px; padding: 18px 0; border-bottom: 1px solid #e8dfd5; }
  .item h3 { margin: 0; font-size: 1.25rem; color: var(--brand); }
  .item p { margin: 4px 0 0; color: #6b605a; }
  .about { background: #fff; text-align: center; }
  .about p { max-width: 640px; margin: 0 auto; font-size: 1.1rem; }
  .stars { color: var(--brand); letter-spacing: .1em; margin-top: 16px; }
  .quote { background: #f3ece4; } .quote h2 { text-align: left; }
  .contact { text-align: center; } .contact a { color: var(--brand); }
  footer { padding: 28px 0; font-size: .85rem; color: #6b605a; text-align: center; border-top: 1px solid #e8dfd5; }
{% endblock %}
{% block header %}<header><div class="wrap">
  <div class="logo">{{ lead.business_name }}</div>
  <nav><a href="#services">Services</a><a href="#about">About</a>{% if quote_action %}<a href="#quote">Book</a>{% endif %}<a href="#contact">Visit</a></nav>
</div></header>{% endblock %}
{% block hero %}<div class="hero"><div class="wrap">
  <h1>{{ copy.headline }}</h1>
  <p>{{ copy.tagline }}</p>
  <div class="actions">
  {% if lead.phone %}<a class="btn" href="tel:{{ lead.phone|replace(' ', '') }}">{{ copy.cta }}</a>{% endif %}
  {% if quote_action %}<a class="btn" href="#quote">Request an appointment</a>{% endif %}
  </div>
</div></div>{% endblock %}
{% block services %}<section id="services"><div class="wrap">
  <h2>Services</h2>
  <div class="menu">{% for s in copy.services %}<div class="item"><div><h3>{{ s.name }}</h3><p>{{ s.description }}</p></div></div>{% endfor %}</div>
</div></section>{% endblock %}
{% block about %}<section class="about" id="about"><div class="wrap">
  <h2>About</h2>
  <p>{{ copy.about }}</p>
  {% if lead.rating %}<div class="stars">{{ lead.rating }}★ <span style="color:#6b605a">{% if lead.review_count %}from {{ lead.review_count }} reviews{% else %}average rating{% endif %}</span></div>{% endif %}
</div></section>{% endblock %}
{% block contact %}<section class="contact" id="contact"><div class="wrap">
  <h2>Visit Us</h2>
  {% if lead.address %}<p>{{ lead.address }}</p>{% endif %}
  {% if copy.hours %}<p>{{ copy.hours }}</p>{% endif %}
  {% if lead.phone %}<p><a href="tel:{{ lead.phone|replace(' ', '') }}">{{ lead.phone }}</a></p>{% endif %}
</div></section>{% endblock %}
